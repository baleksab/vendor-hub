{
  "name": "mfe-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter \"!@mfe/server\" -r --parallel dev",
    "types:generate": "pnpm --filter @vendor-hub/types types:generate",
    "server:dev": "pnpm --filter @mfe/server dev",
    "build": "pnpm --filter @mfe/remote-test build && pnpm --filter @mfe/shell build && pnpm --filter @mfe/server build",
    "db:up": "docker compose --env-file packages/server/.env.local --env-file packages/server/.env.secret up -d --wait postgres",
    "db:down": "docker compose --env-file packages/server/.env.local --env-file packages/server/.env.secret down",
    "db:reset": "docker compose --env-file packages/server/.env.local --env-file packages/server/.env.secret down --volumes",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1"
}
