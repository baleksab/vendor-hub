{
  "name": "@mfe/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env --env-file=.env.local --env-file=.env.secret src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env --env-file=.env.local --env-file=.env.secret dist/src/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --env-file=.env.local --env-file=.env.secret src/db/migrate.ts",
    "db:seed-admin": "node --env-file=.env --env-file=.env.local --env-file=.env.secret src/db/seed-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file=.env --env-file=.env.local --env-file=.env.secret ./node_modules/vitest/vitest.mjs run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@fastify/multipart": "catalog:",
    "@fastify/swagger": "catalog:",
    "@fastify/swagger-ui": "catalog:",
    "@node-rs/argon2": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "jose": "catalog:",
    "openapi-types": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "vitest": "catalog:"
  }
}
