# Bind address of the API server
SERVER_HOST=
SERVER_PORT=

# Postgres connection (the password is in .env.secret)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=

# Lifetime of an access token in seconds
JWT_EXPIRES_IN_SECONDS=

# Secrets, set in .env.secret (copy .env.secret.example)
# DB_PASSWORD=
# JWT_SECRET=

# First administrator, read only by `pnpm --filter @mfe/server db:seed-admin`
# Non-secret part goes to .env.local, ADMIN_EMAIL and ADMIN_PASSWORD to .env.secret
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_ADDRESS=
ADMIN_PHONE_NUMBER=
ADMIN_COUNTRY=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Product images: directory for the files, size limit in bytes and the number of images per product
PRODUCT_IMAGE_DIR=
PRODUCT_IMAGE_MAX_BYTES=
PRODUCT_IMAGE_MAX_PER_PRODUCT=

# Cart: the largest number of distinct products in one cart (quote and order requests)
CART_MAX_LINES=

# Orders: minutes an unpaid order waits for payment, failed payments before it is cancelled,
# days after delivery in which the buyer can ask for a return
ORDER_PAYMENT_TTL_MINUTES=
ORDER_PAYMENT_MAX_ATTEMPTS=
ORDER_RETURN_WINDOW_DAYS=
# Order scheduler: seconds between runs and orders handled per job and run
ORDER_SCHEDULER_INTERVAL_SECONDS=
ORDER_SCHEDULER_BATCH_SIZE=
