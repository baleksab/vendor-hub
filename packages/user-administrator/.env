# Bind address of the dev/preview server
USER_ADMINISTRATOR_HOST=
USER_ADMINISTRATOR_PORT=
# Public origin the remote is served from (used as Vite base so manifest asset URLs resolve)
USER_ADMINISTRATOR_PUBLIC_ORIGIN=
# Comma-separated origins allowed by CORS (the shell origin)
USER_ADMINISTRATOR_ALLOWED_ORIGINS=
# Origin of the API, used only by the standalone dev server to proxy /api/v1
USER_ADMINISTRATOR_API_URL=
