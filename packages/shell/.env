# Bind address of the dev server and react-router-serve
SHELL_HOST=
SHELL_PORT=
# Public origin of the shell
SHELL_ORIGIN=
# Default UI locale, one of LOCALES in src/i18n/locales.ts
DEFAULT_LOCALE=
# Full URL of the remote's mf-manifest.json
REMOTE_TEST_MANIFEST_URL=
# Origin of the API, used only on the shell server
API_URL=
# Name of the HttpOnly cookie that holds the access token
SESSION_COOKIE_NAME=
# "true" in production (cookie is sent only over HTTPS)
SESSION_COOKIE_SECURE=
# Origin template of a vendor site, with exactly one {slug} placeholder
VENDOR_SITE_ORIGIN=
# Request header set by nginx with the vendor slug, empty on the main site
VENDOR_SLUG_HEADER=
