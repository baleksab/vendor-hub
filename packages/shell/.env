# Bind address of the dev server and react-router-serve
SHELL_HOST=
SHELL_PORT=
# Public origin of the shell
SHELL_ORIGIN=
# Default UI locale, one of LOCALES in src/i18n/locales.ts
DEFAULT_LOCALE=
# Full URL of the user-administrator remote's mf-manifest.json
USER_ADMINISTRATOR_MANIFEST_URL=
# Full URL of the vendor-administrator remote's mf-manifest.json
VENDOR_ADMINISTRATOR_MANIFEST_URL=
# Full URL of the insights remote's mf-manifest.json
INSIGHTS_MANIFEST_URL=
# Origin of the API, used only on the shell server
API_URL=
# Name of the HttpOnly cookie that holds the access token
SESSION_COOKIE_NAME=
# "true" in production (cookie is sent only over HTTPS)
SESSION_COOKIE_SECURE=
# Name of the HttpOnly cookie that holds the cart and the checkout details (signed)
CART_COOKIE_NAME=
# Largest number of distinct products in the cart and largest quantity of one product
CART_MAX_LINES=
CART_MAX_QUANTITY_PER_LINE=
# Secret, set in .env.secret (copy .env.secret.example): signs the cart cookie
# SHELL_SESSION_SECRET=
