upstream shell {
  server ${SHELL_UPSTREAM};
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      close;
}

map $host $vendor_slug {
  default "";
  "~^(?<slug>[a-z0-9]([a-z0-9-]*[a-z0-9])?)\.${VENDOR_BASE_DOMAIN}$" $slug;
}

server {
  listen ${NGINX_PORT} default_server;
  server_name ${VENDOR_BASE_DOMAIN};

  location = /nginx-health {
    access_log off;
    default_type text/plain;
    return 200 "ok";
  }

  location / {
    proxy_pass http://shell;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header ${VENDOR_SLUG_HEADER} "";
  }
}

server {
  listen ${NGINX_PORT};
  server_name *.${VENDOR_BASE_DOMAIN};

  if ($vendor_slug = "") {
    return 302 ${MAIN_SITE_ORIGIN}$request_uri;
  }

  location ~ ^(/|/(assets|@vite|@id|@fs|@react-router|node_modules|src)/.*|/(_root\.data|favicon\.svg|locale|locale\.data))$ {
    proxy_pass http://shell;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header ${VENDOR_SLUG_HEADER} $vendor_slug;
  }

  location / {
    return 302 ${MAIN_SITE_ORIGIN}$request_uri;
  }
}
