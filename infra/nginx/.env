# Port nginx listens on (the public port of the main site and the vendor sites)
NGINX_PORT=
# Base domain: the main site is served here, vendor sites on <slug>.<this domain>
VENDOR_BASE_DOMAIN=
# host:port of the shell that nginx proxies to
SHELL_UPSTREAM=
# Public origin of the main site, vendor sites redirect unknown paths here
MAIN_SITE_ORIGIN=
# Request header with the vendor slug, must match the shell's VENDOR_SLUG_HEADER
VENDOR_SLUG_HEADER=
